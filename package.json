{
  "name": "@gchust/agent-annotations",
  "displayName": "Agent Annotations",
  "description": "Developer-only visual annotations handed to Code Agents in React/Vite applications",
  "version": "0.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gchust/agent-annotations.git"
  },
  "bugs": {
    "url": "https://github.com/gchust/agent-annotations/issues"
  },
  "homepage": "https://github.com/gchust/agent-annotations#readme",
  "keywords": [
    "agent-annotations",
    "annotations",
    "code-agent",
    "developer-tools",
    "react",
    "vite"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.mts",
      "import": "./dist/vite/index.mjs"
    },
    "./vite/client": {
      "types": "./dist/vite/client.d.ts",
      "import": "./dist/vite/client.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "agent-annotations": "./dist/cli/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:release": "vitest run --exclude tests/release/core-exports.test.ts --exclude tests/release/pack-regression.test.ts --exclude tests/release/packed-e2e-failure.test.ts",
    "test:e2e": "node scripts/packed-e2e.mjs",
    "test:e2e:repeat": "node scripts/repeat-e2e.mjs",
    "prepack": "pnpm build && node scripts/verify-dist.mjs",
    "prepublishOnly": "pnpm release:verify",
    "release:verify": "node scripts/release-verify.mjs",
    "check:architecture": "vitest run tests/audit/architecture-audit.test.ts",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:docs": "node scripts/docs-smoke.mjs",
    "check:tarball": "node scripts/tarball-audit.mjs"
  },
  "dependencies": {
    "magic-string": "0.30.21",
    "react-grab": "0.1.50"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "26.1.0",
    "publint": "0.3.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.28.1"
}
